<Window x:Class="HGC.PcComponentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PC Component"
        Width="560"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PcComponentScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        Opacity="0.75"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PcComponentScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource PcComponentScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <TextBlock Text="PC Component"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <Button Content="X"
                        Width="44"
                        Height="36"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#E81123"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#8B1A12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowTitleText"
                       Grid.Row="0"
                       Text="Dodaj komponent"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextBrush}"
                       Margin="0,0,0,18"/>

            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource PcComponentScrollViewerStyle}">

                <StackPanel>

                    <!-- BASIC -->
                    <Border Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14">

                        <StackPanel>
                            <TextBlock x:Name="BasicTitle"
                                       Text="Podstawowe informacje"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="ManufacturerLabel"
                                       Text="Producent"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="ManufacturerTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="ModelLabel"
                                       Text="Model"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="ModelTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border x:Name="RamPanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock x:Name="RamTitle"
                                       Text="RAM"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="RamModuleCountLabel"
                                       Text="Liczba modułów"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="RamModuleCountTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="RamCapacityLabel"
                                       Text="Pojemność całkowita"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="RamCapacityTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="RamTypeLabel"
                                       Text="Typ pamięci"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <ComboBox x:Name="RamTypeCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      Foreground="#111111"
                                      TextElement.Foreground="#111111"/>

                            <CheckBox x:Name="RamEccCheckBox"
                                      Content="ECC"
                                      Foreground="{DynamicResource AppTextBrush}"
                                      Margin="0,0,0,8"/>

                            <CheckBox x:Name="RamRegisteredCheckBox"
                                      Content="Registered / Buffered"
                                      Foreground="{DynamicResource AppTextBrush}"
                                      Margin="0,0,0,12"/>

                            <TextBlock x:Name="RamProfileLabel"
                                       Text="Profil"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <ComboBox x:Name="RamProfileCombo"
                                      Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock x:Name="RamClockLabel"
                                       Text="Taktowanie"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="RamClockTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="RamVoltageLabel"
                                       Text="Napięcie"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="RamVoltageTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM TIMINGS -->
                    <Border x:Name="RamTimingsPanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Timingi"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="CL" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamCLTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tRCD" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRCDTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tRP" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRPTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tRAS" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRASTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tRC" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRCTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="CR" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamCommandRateTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Timingi zaawansowane"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,8,0,12"/>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tRFC" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRFCTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tREFI" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTREFITextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tFAW" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTFAWTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tRRD_S" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRRDSTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tRRD_L" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTRRDLTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tWTR_S" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTWTRSTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="tWTR_L" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTWTRLTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="tCWL" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBox x:Name="RamTCWLTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- RAM OC -->
                    <Border x:Name="RamOverclockPanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <CheckBox x:Name="RamHasOverclockCheckBox"
                                      Content="Dodaj podkręcenie"
                                      Foreground="{DynamicResource AppTextBrush}"
                                      Margin="0,0,0,10"
                                      Checked="RamHasOverclockCheckBox_Checked"
                                      Unchecked="RamHasOverclockCheckBox_Checked"/>

                            <StackPanel x:Name="RamOverclockFieldsPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Taktowanie OC" Foreground="{DynamicResource AppTextBrush}"/>
                                <TextBox x:Name="RamOcClockTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock Text="Napięcie OC" Foreground="{DynamicResource AppTextBrush}"/>
                                <TextBox x:Name="RamOcVoltageTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="CL" Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBox x:Name="RamOcCLTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="tRCD" Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBox x:Name="RamOcTRCDTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="tRP" Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBox x:Name="RamOcTRPTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="tRAS" Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBox x:Name="RamOcTRASTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- STORAGE -->
                    <Border x:Name="StoragePanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Dysk"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Pojemność" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="StorageCapacityTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Typ dysku" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="StorageDriveTypeCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Interfejs" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="StorageInterfaceCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Format" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="StorageFormFactorCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <CheckBox x:Name="StorageBootDriveCheckBox"
                                      Content="Dysk systemowy"
                                      Foreground="{DynamicResource AppTextBrush}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="RPM" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="StorageRpmTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Cache" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="StorageCacheTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Kontroler" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="StorageControllerTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="NAND" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="StorageNandTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <CheckBox x:Name="StorageDramCacheCheckBox"
                                      Content="DRAM Cache"
                                      Foreground="{DynamicResource AppTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- PSU -->
                    <Border x:Name="PsuPanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Zasilacz"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Moc" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="PsuPowerTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Format" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="PsuFormFactorCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Standard / wersja" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="PsuStandardCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Certyfikat" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="PsuCertificateCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Modularność" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="PsuModularityCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Zabezpieczenia"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,8,0,12"/>

                            <WrapPanel>
                                <CheckBox x:Name="PsuOcpCheckBox" Content="OCP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuOvpCheckBox" Content="OVP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuUvpCheckBox" Content="UVP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuOppCheckBox" Content="OPP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuOtpCheckBox" Content="OTP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuScpCheckBox" Content="SCP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuSipCheckBox" Content="SIP" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="PsuNloCheckBox" Content="NLO" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,16,8"/>
                            </WrapPanel>

                            <CheckBox x:Name="PsuHasRailsCheckBox"
                                      Content="Dodaj linie zasilania"
                                      Foreground="{DynamicResource AppTextBrush}"
                                      Margin="0,8,0,10"
                                      Checked="PsuHasRailsCheckBox_Checked"
                                      Unchecked="PsuHasRailsCheckBox_Checked"/>

                            <StackPanel x:Name="PsuRailsPanel"
                                        Visibility="Collapsed">

                                <TextBox x:Name="PsuRail12V1TextBox" Height="34" Margin="0,0,0,8"/>
                                <TextBox x:Name="PsuRail12V2TextBox" Height="34" Margin="0,0,0,8"/>
                                <TextBox x:Name="PsuRail12V3TextBox" Height="34" Margin="0,0,0,8"/>
                                <TextBox x:Name="PsuRail12V4TextBox" Height="34" Margin="0,0,0,8"/>
                                <TextBox x:Name="PsuRail5VTextBox" Height="34" Margin="0,0,0,8"/>
                                <TextBox x:Name="PsuRail33VTextBox" Height="34" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CASE -->
                    <Border x:Name="CasePanel"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Obudowa"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Typ obudowy" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="CaseTypeCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Kolor" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="CaseColorCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <CheckBox x:Name="CaseSideWindowCheckBox" Content="Okno boczne" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CaseTemperedGlassCheckBox" Content="Hartowane szkło" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CaseRgbCheckBox" Content="RGB" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CaseVerticalGpuCheckBox" Content="Pionowy montaż GPU" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CaseHotSwapCheckBox" Content="Hot-Swap" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CaseSoundDampingCheckBox" Content="Wyciszenie" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,12"/>

                            <TextBlock Text="Maks. płyta główna" Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox x:Name="CaseMaxMotherboardCombo" Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock Text="Maks. długość GPU" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="CaseMaxGpuLengthTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock Text="Maks. wysokość chłodzenia CPU" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBox x:Name="CaseMaxCpuCoolerHeightTextBox" Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- PURCHASE -->
                    <Border Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">

                        <StackPanel>
                            <TextBlock x:Name="PurchaseTitle"
                                       Text="Zakup"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="PurchaseDateLabel"
                                       Text="Data zakupu"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <DatePicker x:Name="PurchaseDatePicker"
                                        Height="34"
                                        Margin="0,6,0,12"/>

                            <TextBlock x:Name="PurchasePriceLabel"
                                       Text="Cena zakupu"
                                       Foreground="{DynamicResource AppTextBrush}"/>

                            <TextBox x:Name="PurchasePriceTextBox"
                                 Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Style="{StaticResource FormCancelButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Zapisz"
                        Style="{StaticResource FormSaveButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>