<Window x:Class="HGC.PcGpuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GPU"
        Width="560"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PcGpuScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        Opacity="0.75"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PcGpuScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource PcGpuScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <TextBlock Text="GPU"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <Button Content="X"
                        Width="44"
                        Height="36"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#E81123"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#8B1A12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Style="{StaticResource FormRootGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowTitleText"
                       Grid.Row="0"
                       Text="Dodaj kartę graficzną"
                       Style="{StaticResource FormTitleTextStyle}"/>

            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource PcGpuScrollViewerStyle}">

                <StackPanel>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GpuBasicTitle"
                                       Text="Podstawowe informacje"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="GpuManufacturerLabel"
                                       Text="Producent GPU"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuManufacturerTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuModelLabel"
                                       Text="Model"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuModelTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuCardManufacturerLabel"
                                       Text="Producent karty"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuCardManufacturerTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="GpuHasSerialCheckBox"
                                      Content="Dodaj numer seryjny"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Checked="GpuHasSerialCheckBox_Checked"
                                      Unchecked="GpuHasSerialCheckBox_Checked"/>

                            <StackPanel x:Name="GpuSerialPanel"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="GpuSerialLabel"
                                           Text="Numer seryjny"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="GpuSerialTextBox"
                                         Style="{StaticResource FormLastTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GpuDetailsTitle"
                                       Text="Szczegóły"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="GpuVramAmountLabel"
                                       Text="Ilość pamięci VRAM"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuVramAmountTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuVramTypeLabel"
                                       Text="Rodzaj pamięci VRAM"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuVramTypeTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuVramBusLabel"
                                       Text="Szyna pamięci VRAM"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuVramBusTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuVramClockLabel"
                                       Text="Taktowanie pamięci VRAM"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuVramClockTextBox"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <TextBlock x:Name="GpuCoreClockLabel"
                                       Text="Taktowanie rdzenia"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuCoreClockTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="GpuHasOverclockCheckBox"
                                      Content="Dodaj podkręcenie"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Checked="GpuHasOverclockCheckBox_Checked"
                                      Unchecked="GpuHasOverclockCheckBox_Checked"/>

                            <StackPanel x:Name="GpuOverclockPanel"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="GpuOverclockCoreLabel"
                                           Text="Aktualne taktowanie rdzenia"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="GpuOverclockCoreTextBox"
                                         Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuOverclockMemoryLabel"
                                           Text="Aktualne taktowanie pamięci"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="GpuOverclockMemoryTextBox"
                                         Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuPowerLimitLabel"
                                           Text="Aktualny limit mocy"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="GpuPowerLimitTextBox"
                                         Style="{StaticResource FormLastTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GpuInterfaceTitle"
                                       Text="Interfejs karty"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="GpuInterfaceTypeLabel"
                                       Text="Typ interfejsu"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <ComboBox x:Name="GpuInterfaceTypeCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      SelectionChanged="GpuInterfaceTypeCombo_SelectionChanged"/>

                            <TextBlock x:Name="GpuInterfaceVersionLabel"
                                       Text="Wersja interfejsu"
                                       Style="{StaticResource FormLabelTextStyle}"
                                       Visibility="Collapsed"/>

                            <ComboBox x:Name="GpuInterfaceVersionCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="GpuHasCoreDetailsCheckBox"
                                      Content="Dodaj szczegóły rdzenia"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Checked="GpuHasCoreDetailsCheckBox_Checked"
                                      Unchecked="GpuHasCoreDetailsCheckBox_Checked"/>

                            <StackPanel x:Name="GpuCoreDetailsPanel"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="GpuRopsLabel" Text="ROP" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuRopsTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuTmusLabel" Text="TMU" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuTmusTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuVertexShadersLabel" Text="Vertex Shader / VS" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuVertexShadersTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuPixelShadersLabel" Text="Pixel Shader / PS" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuPixelShadersTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuUnifiedShadersLabel" Text="Unified Shaders" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuUnifiedShadersTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuCudaCoresLabel" Text="CUDA Cores" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuCudaCoresTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuStreamProcessorsLabel" Text="Stream Processors" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuStreamProcessorsTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuRtUnitsLabel" Text="RT Units" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuRtUnitsTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuTensorUnitsLabel" Text="Tensor Units" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox x:Name="GpuTensorUnitsTextBox" Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="GpuOtherCoreDetailsLabel"
                                           Text="Inne szczegóły rdzenia"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="GpuOtherCoreDetailsTextBox"
                                         Style="{StaticResource FormLastTextBoxStyle}"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Padding="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormLastCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GpuPurchaseTitle"
                                       Text="Zakup"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="GpuPurchaseDateLabel"
                                       Text="Data zakupu"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <DatePicker x:Name="GpuPurchaseDatePicker"
                                        Style="{StaticResource FormDatePickerStyle}"/>

                            <TextBlock x:Name="GpuPurchasePriceLabel"
                                       Text="Cena zakupu"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="GpuPurchasePriceTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Style="{StaticResource FormCancelButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Zapisz"
                        Style="{StaticResource FormSaveButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>