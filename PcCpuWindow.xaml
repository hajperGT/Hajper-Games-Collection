<Window x:Class="HGC.PcCpuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CPU"
        Width="520"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PcCpuScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        Opacity="0.75"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PcCpuScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource PcCpuScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}">

            <Grid>
                <TextBlock Text="CPU"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <Button Content="X"
                        Width="44"
                        Height="36"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#E81123"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CloseBorder"
                                                        Property="Background"
                                                        Value="#8B1A12"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Style="{StaticResource FormRootGridStyle}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowTitleText"
                       Grid.Row="0"
                       Text="Dodaj procesor"
                       Style="{StaticResource FormTitleTextStyle}"/>

            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource PcCpuScrollViewerStyle}">

                <StackPanel>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CpuBasicTitle"
                                       Text="Podstawowe informacje"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="CpuManufacturerLabel"
                                       Text="Producent"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <ComboBox x:Name="CpuManufacturerCombo"
                                      Style="{StaticResource FormComboBoxStyle}"/>

                            <TextBlock x:Name="CpuModelLabel"
                                       Text="Model"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="CpuModelTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="CpuHasSerialCheckBox"
                                      Content="Dodaj numer seryjny"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Checked="CpuHasSerialCheckBox_Checked"
                                      Unchecked="CpuHasSerialCheckBox_Checked"/>

                            <StackPanel x:Name="CpuSerialPanel"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="CpuSerialLabel"
                                           Text="Numer seryjny"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="CpuSerialTextBox"
                                         Style="{StaticResource FormLastTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="CpuHasOverclockCheckBox"
                                      Content="Dodaj podkręcenie"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Checked="CpuHasOverclockCheckBox_Checked"
                                      Unchecked="CpuHasOverclockCheckBox_Checked"/>

                            <StackPanel x:Name="CpuOverclockPanel"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="CpuClockLabel"
                                           Text="Aktualny zegar"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="CpuClockTextBox"
                                         Style="{StaticResource FormTextBoxStyle}"/>

                                <TextBlock x:Name="CpuVoltageLabel"
                                           Text="Aktualne napięcie"
                                           Style="{StaticResource FormLabelTextStyle}"/>

                                <TextBox x:Name="CpuVoltageTextBox"
                                         Style="{StaticResource FormLastTextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FormLastCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CpuPurchaseTitle"
                                       Text="Zakup"
                                       Style="{StaticResource FormSectionTitleStyle}"/>

                            <TextBlock x:Name="CpuPurchaseDateLabel"
                                       Text="Data zakupu"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <DatePicker x:Name="CpuPurchaseDatePicker"
                                        Style="{StaticResource FormDatePickerStyle}"/>

                            <TextBlock x:Name="CpuPurchasePriceLabel"
                                       Text="Cena zakupu"
                                       Style="{StaticResource FormLabelTextStyle}"/>

                            <TextBox x:Name="CpuPurchasePriceTextBox"
                                     Style="{StaticResource FormLastTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Style="{StaticResource FormCancelButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Zapisz"
                        Style="{StaticResource FormSaveButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>