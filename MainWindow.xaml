<Window x:Class="HGC.MainWindow"
        Icon="/Assets/Icons/hgcmainico.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hajper Games Collection"
        Width="1520"
        Height="1010"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="Fant"
        Background="{DynamicResource AppBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0D0F"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#121417"/>
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#121417"/>
        <SolidColorBrush x:Key="MenuPopupBackgroundBrush" Color="#121417"/>
        <SolidColorBrush x:Key="MenuPopupBorderBrush" Color="#B85F0D"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#5F3000"/>

        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181B1F"/>
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#20242A"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#B85F0D"/>
        <SolidColorBrush x:Key="AppTextBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#353A42"/>
        <SolidColorBrush x:Key="StatsBackgroundBrush" Color="#14171A"/>
        <SolidColorBrush x:Key="PreviewBoxBrush" Color="#14171A"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#111111"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000"/>

        <Style x:Key="AddTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="190"/>
            <Setter Property="Background" Value="{DynamicResource ButtonGradientBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            Color="Black"
            BlurRadius="14"
            ShadowDepth="5"
            Opacity="0.45"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="TextElement.Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                           Foreground="#111111"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <!-- ================= MENU TEMPLATES ================= -->

        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="Bd"
                     Background="{DynamicResource MenuBackgroundBrush}"
                        Padding="12,7">
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource AppTextBrush}"/>
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource MenuPopupBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuPopupBorderBrush}"
                            BorderThickness="1"
                            Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </Popup>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>

                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TopLevelItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bd"
                    Background="{DynamicResource MenuBackgroundBrush}"
                    Padding="12,7">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource AppTextBrush}"/>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="Bd"
                        Background="{DynamicResource MenuPopupBackgroundBrush}"
                        Padding="12,7">
                    <Grid Width="210">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource AppTextBrush}"/>

                        <Path Grid.Column="1"
                              Data="M 0 0 L 5 4 L 0 8 Z"
                              Fill="{DynamicResource AppTextBrush}"
                              Width="5"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource MenuPopupBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuPopupBorderBrush}"
                            BorderThickness="1"
                            Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </Popup>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bd"
            Background="{DynamicResource MenuPopupBackgroundBrush}"
            Padding="8,7">

                <Grid Width="210">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CheckMark"
                       Grid.Column="0"
                       Text="✓"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource AppTextBrush}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                    <ContentPresenter Grid.Column="1"
                              ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource AppTextBrush}"/>
                </Grid>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd"
                    Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark"
                    Property="Visibility"
                    Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuItemTemplateCompact" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bd"
            Background="{DynamicResource MenuPopupBackgroundBrush}"
            Padding="8,7">
                <Grid Width="135">
                    <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource AppTextBrush}"/>
                </Grid>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd"
                    Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CompactSubmenuItemStyle"
       TargetType="{x:Type MenuItem}">
            <Setter Property="Template"
            Value="{StaticResource SubmenuItemTemplateCompact}"/>
        </Style>

        <!-- ================= STYLES ================= -->

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonGradientBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter Content="{TemplateBinding Content}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RecognizesAccessKey="True"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Collapsed" Handler="TreeViewItem_Collapsed"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header"
                                          ContentSource="Header"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                    Margin="16,0,0,0"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost"
                                Property="Visibility"
                                Value="Collapsed"/>
                            </Trigger>

                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                Property="Background"
                                Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>

                                <Setter TargetName="Bd"
                                Property="Background"
                                Value="{DynamicResource AppAccentBrush}"/>

                                <Setter Property="Foreground"
                                Value="{DynamicResource ButtonTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{DynamicResource PanelBackgroundBrush}">
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource AppAccentBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalPhotoScrollBarStyle"
       TargetType="{x:Type ScrollBar}">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{DynamicResource PanelBackgroundBrush}">
                            <Track x:Name="PART_Track"
                           Orientation="Horizontal"
                           IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource AppAccentBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}">
            <Grid>

                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="12,0,0,0">

                    <Image Source="/Assets/Icons/hgcmainico.ico"
               Width="16"
               Height="16"
               Margin="0,0,8,0"/>

                    <TextBlock Text="Hajper Games Collection"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Opacity="0.85"
                   FontSize="11"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

                    <Button Content="—"
                            Width="44"
                            Style="{StaticResource TitleButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"/>

                    <Button Content="□"
                            Width="44"
                            Style="{StaticResource TitleButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"/>

                    <Button Content="X"
                            Width="44"
                            Background="#C42B1C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CLASSIC MENU -->
        <Border Grid.Row="1"
        Background="{DynamicResource MenuBackgroundBrush}"
        Padding="5,0,0,0"
                Margin="10,0,10,0"
                CornerRadius="8">

            <Border.Effect>
                <DropShadowEffect
            Color="Black"
            BlurRadius="16"
            ShadowDepth="3"
            Opacity="0.22"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0"
                      Margin="0,4,12,0"
                      FontSize="13">

                    <MenuItem x:Name="MenuFile">

                        <MenuItem x:Name="MenuCreateBackup"
              Style="{StaticResource CompactSubmenuItemStyle}"
              Click="MenuCreateBackup_Click"/>

                        <MenuItem x:Name="MenuRestoreBackup"
              Style="{StaticResource CompactSubmenuItemStyle}"
              Click="MenuRestoreBackup_Click"/>

                        <MenuItem x:Name="MenuClearCollection"
              Style="{StaticResource CompactSubmenuItemStyle}"
              Click="MenuClearCollection_Click"/>

                        <MenuItem x:Name="MenuRestartApplication"
              Style="{StaticResource CompactSubmenuItemStyle}"
              Click="MenuRestartApplication_Click"/>

                        <MenuItem x:Name="MenuExitApplication"
              Style="{StaticResource CompactSubmenuItemStyle}"
              Click="MenuExitApplication_Click"/>

                    </MenuItem>

                    <MenuItem x:Name="MenuStats"
                        Click="MenuStats_Click"/>

                    <MenuItem x:Name="MenuSettings"
                               Margin="0,0,-4,0">
                        <MenuItem x:Name="MenuLanguage">
                            <MenuItem x:Name="MenuPolish"
                          IsCheckable="True"
                          Click="MenuPolish_Click"
                          Width="100"/>

                            <MenuItem x:Name="MenuEnglish"
                          IsCheckable="True"
                          Click="MenuEnglish_Click"
                          Width="100"/>
                        </MenuItem>

                        <MenuItem x:Name="MenuTheme">
                            <MenuItem x:Name="MenuThemeDefault" Header="Classic" Width="120" Padding="2,0,4,0" Click="ThemeDefault_Click"/>
                            <MenuItem x:Name="MenuThemeModern" Header="Modern" Width="120" Padding="2,0,4,0" Click="ThemeModern_Click"/>
                            <MenuItem x:Name="MenuThemePlayStation" Header="PS" Width="120" Padding="2,0,4,0" Click="ThemePlayStation_Click"/>
                            <MenuItem x:Name="MenuThemeXbox" Header="Redmond" Width="120" Padding="2,0,4,0" Click="ThemeXbox_Click"/>
                            <MenuItem x:Name="MenuThemeSega" Header="Blue Team" Width="120" Padding="2,0,4,0" Click="ThemeSega_Click"/>
                            <MenuItem x:Name="MenuThemeNintendo" Header="The Big N" Width="120" Padding="2,0,4,0" Click="ThemeNintendo_Click"/>
                            <MenuItem x:Name="MenuThemeAtari" Header="Vader" Width="120" Padding="2,0,4,0" Click="ThemeAtari_Click"/>
                            <MenuItem x:Name="MenuThemeCommodore" Header="Breadbox" Width="120" Padding="2,0,4,0" Click="ThemeCommodore_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="MenuOpacity">
                            <MenuItem x:Name="MenuOpacity100" Header="100%" IsCheckable="True" Click="Opacity100_Click" Width="100"/>
                            <MenuItem x:Name="MenuOpacity90" Header="90%" IsCheckable="True" Click="Opacity90_Click" Width="100"/>
                            <MenuItem x:Name="MenuOpacity80" Header="80%" IsCheckable="True" Click="Opacity80_Click" Width="100"/>
                            <MenuItem x:Name="MenuOpacity70" Header="70%" IsCheckable="True" Click="Opacity70_Click" Width="100"/>
                            <MenuItem x:Name="MenuOpacity60" Header="60%" IsCheckable="True" Click="Opacity60_Click" Width="100"/>
                            <MenuItem x:Name="MenuOpacity50" Header="50%" IsCheckable="True" Click="Opacity50_Click" Width="100"/>
                        </MenuItem>
                        <MenuItem x:Name="MenuDefaultCurrency"/>
                    </MenuItem>

                    <MenuItem x:Name="MenuSorting">

                        <MenuItem x:Name="MenuCategoryOrder">

                            <MenuItem x:Name="MenuCategoryOrderHAG"
                              Tag="HAG"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                            <MenuItem x:Name="MenuCategoryOrderHGA"
                              Tag="HGA"
                              IsCheckable="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                            <MenuItem x:Name="MenuCategoryOrderAHG"
                              Tag="AHG"
                              IsCheckable="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                            <MenuItem x:Name="MenuCategoryOrderAGH"
                              Tag="AGH"
                              IsCheckable="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                            <MenuItem x:Name="MenuCategoryOrderGHA"
                              Tag="GHA"
                              IsCheckable="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                            <MenuItem x:Name="MenuCategoryOrderGAH"
                              Tag="GAH"
                              IsCheckable="True"
                              Click="CollectionCategoryOrderMenu_Click"/>

                        </MenuItem>

                        <MenuItem x:Name="MenuCategoryVisibility">

                            <MenuItem x:Name="MenuShowHardwareCategory"
                              Tag="Hardware"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="CollectionCategoryVisibilityMenu_Click"/>

                            <MenuItem x:Name="MenuShowAccessoriesCategory"
                              Tag="Accessories"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="CollectionCategoryVisibilityMenu_Click"/>

                            <MenuItem x:Name="MenuShowGamesCategory"
                              Tag="Games"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="CollectionCategoryVisibilityMenu_Click"/>

                        </MenuItem>

                        <MenuItem x:Name="MenuCategoryLines">

                            <MenuItem x:Name="MenuCategoryLinesAuto"
