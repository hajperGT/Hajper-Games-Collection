                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed"/>

                                        </Grid>

                                        <Border Height="210"
                                            CornerRadius="10"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,16">

                                            <Grid>

                                                <ScrollViewer x:Name="HardwarePhotosScrollViewer"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Padding="8">

                                                    <ScrollViewer.Resources>
                                                        <Style TargetType="{x:Type ScrollBar}"
                                                            BasedOn="{StaticResource HorizontalPhotoScrollBarStyle}"/>
                                                    </ScrollViewer.Resources>

                                                    <StackPanel x:Name="HardwarePhotosPanel"
                                                        Orientation="Horizontal"/>

                                                </ScrollViewer>

                                                <StackPanel x:Name="HardwareNoPhotoPanel"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                    <Image Source="Assets/Icons/nophoto.png"
                                                       Width="64"
                                                       Height="64"
                                                       Opacity="0.60"/>

                                                    <TextBlock x:Name="HardwarePhotosPlaceholderText"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,0"
                                                       Opacity="0.75"/>

                                                </StackPanel>

                                            </Grid>

                                </Border>

                                        <Border x:Name="GameShortDescriptionBorder"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,16"
                                            Padding="12"
                                            CornerRadius="8"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">

                                            <Border.Background>
                                                <SolidColorBrush Color="White"
                                                    Opacity="0.06"/>
                                            </Border.Background>

                                            <TextBlock x:Name="GameShortDescriptionText"
                                               FontSize="14"
                                               FontStyle="Italic"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                        </Border>

                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LEWA STRONA -->
                                            <StackPanel Grid.Column="0"
                                                Margin="0,0,20,0">

                                                <TextBlock x:Name="HardwareDetailsMainTitle"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Opacity="0.85"
                                                   Margin="0,0,0,10"/>          

                                                <TextBlock x:Name="HardwareDetailsViewText"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"
                                                   Margin="0,0,0,18"/>

                                                <TextBlock x:Name="HardwareDetailsConditionTitle"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Opacity="0.85"
                                                   Margin="0,0,0,10"/>

                                                <TextBlock x:Name="HardwareDetailsConditionText"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"/>

                                            </StackPanel>

                                            <!-- SEPARATOR -->
                                            <Border Grid.Column="1"
                                                Width="1"
                                                Margin="0,4,20,4"
                                                Background="{DynamicResource AppBorderBrush}"
                                                Opacity="0.35"/>

                                            <!-- PRAWA STRONA -->
                                            <StackPanel Grid.Column="2">

                                                <TextBlock x:Name="HardwareDetailsSideTitle"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Opacity="0.85"
                                                   Margin="0,0,0,10"/>

                                                <TextBlock x:Name="HardwareDetailsSideText"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"/>

                                            </StackPanel>

                                        </Grid>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                        <Border x:Name="RecordActionsPanel"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Padding="14"
                            CornerRadius="12"
                            Background="{DynamicResource PreviewBoxGradientBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Margin="10,0,10,10">

                            <StackPanel>
                                <TextBlock x:Name="RecordActionsTitle"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"/>

                                <Grid>
                                    <Popup x:Name="CardOpacityPopup"
                                       PlacementTarget="{Binding ElementName=CardOpacityButton}"
                                       Placement="Top"
                                       StaysOpen="False"
                                       AllowsTransparency="True">

                                        <Border Width="170"
                                            Padding="8"
                                            CornerRadius="10"
                                            Background="{DynamicResource PreviewBoxBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">

                                            <StackPanel>
                                                <Button Content="50%" Click="CardOpacityValue_Click"/>
                                                <Button Content="60%" Click="CardOpacityValue_Click"/>
                                                <Button Content="70%" Click="CardOpacityValue_Click"/>
                                                <Button Content="80%" Click="CardOpacityValue_Click"/>
                                                <Button Content="90%" Click="CardOpacityValue_Click"/>
                                                <Button Content="100%" Click="CardOpacityValue_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                        <Button x:Name="EditRecordButton"
                                            Width="130"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Click="EditRecordButton_Click"/>                

                                        <Button x:Name="CardOpacityButton"
                                            Width="170"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Content="Przezroczystość 0% ▼"
                                            Click="CardOpacityButton_Click"/>

                                        <Button x:Name="AddPageBackgroundButton"
                                            Width="170"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Click="AddPageBackgroundButton_Click"/>

                                        <Button x:Name="AddServiceButton"
                                            Width="140"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Click="AddServiceButton_Click"/>

                                        <Button x:Name="ArchiveRecordButton"
                                            Width="170"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Click="ArchiveRecordButton_Click"/>

                                        <Button x:Name="DeleteRecordButton"
                                            Width="120"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            Click="DeleteRecordButton_Click"/>

                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <Grid x:Name="CollectionTilesPanel"
                      Panel.ZIndex="4"
                      Visibility="Collapsed"
                      Background="Transparent">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="CollectionTilesScrollViewer"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      IsDeferredScrollingEnabled="False">

                            <StackPanel Margin="10">

                                <TextBlock x:Name="CollectionTilesTitle"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Opacity="0.85"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Margin="0,0,0,16">

                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black"
                                      BlurRadius="6"
                                      ShadowDepth="2"
                                      Opacity="0.55"/>
                                    </TextBlock.Effect>

                                </TextBlock>

                                <Border x:Name="RecentlyAddedBorder"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,6"
                                    Padding="12,10,18,10"
                                    CornerRadius="14"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">

                                    <Border.Background>
                                        <SolidColorBrush Color="White"
                                            Opacity="0.06"/>
                                    </Border.Background>

                                    <StackPanel>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                x:Name="RecentlyAddedImageContainer"
                                                Width="120"
                                                Height="150"
                                                CornerRadius="7"
                                                HorizontalAlignment="Left"
                                                Background="Transparent">

                                                <Image x:Name="RecentlyAddedImage"
                                                   Width="130"
                                                   Height="150"
                                                   Stretch="Uniform"
                                                   Opacity="0.95"/>

                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal"
                                                        Margin="0,-4,0,0">

                                                        <TextBlock x:Name="RecentlyAddedTitle"
                                                           FontSize="28"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>

                                                        <TextBlock x:Name="RecentlyAddedHeaderText"
                                                           Text="OSTATNIO DODANA GRA"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           Opacity="1"
                                                           VerticalAlignment="Center"
                                                           Margin="14,6,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="RecentlyAddedRatingPanel"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,6"/>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Platforma -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                                            <TextBlock x:Name="RecentlyAddedPlatformHeader"
                   Text="Platforma"
                   FontSize="11"
                   Opacity="0.50"
                   Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="RecentlyAddedPlatformText"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
            Background="{DynamicResource AppBorderBrush}"
            Opacity="0.35"/>

                                                        <!-- Data dodania -->
                                                        <StackPanel Grid.Column="2" Margin="24,0,24,0">
                                                            <TextBlock x:Name="RecentlyAddedDateHeader"
                                                               Text="Data dodania"
                                                               FontSize="11"
                                                               Opacity="0.50"
                                                               Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="RecentlyAddedDateText"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="3"
                                                            Background="{DynamicResource AppBorderBrush}"
                                                            Opacity="0.35"/>

                                                        <!-- Gatunek -->
                                                        <StackPanel Grid.Column="4" Margin="24,0,24,0">
                                                            <TextBlock x:Name="RecentlyAddedGenreHeader"
                                                               Text="Gatunek"
                                                               FontSize="11"
                                                               Opacity="0.50"
                                                               Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="RecentlyAddedGenreText"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="5"
                                                            Background="{DynamicResource AppBorderBrush}"
                                                            Opacity="0.35"/>

                                                        <!-- Wydawca -->
                                                        <StackPanel Grid.Column="6" Margin="24,0,24,0">
                                                            <TextBlock x:Name="RecentlyAddedPublisherHeader"
                                                                   Text="Wydawca"
                                                                   FontSize="11"
                                                                   Opacity="0.50"
                                                                   Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="RecentlyAddedPublisherText"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="7"
                                                            Background="{DynamicResource AppBorderBrush}"
                                                            Opacity="0.35"/>

                                                        <!-- Status -->
                                                        <StackPanel Grid.Column="8" Margin="24,0,0,0">
                                                            <TextBlock x:Name="RecentlyAddedStatusHeader"
                                                               Text="Status"
                                                               FontSize="11"
                                                               Opacity="0.50"
                                                               Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="RecentlyAddedStatusText"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock x:Name="RecentlyAddedDescription"
                                                       FontSize="14"
                                                       FontStyle="Italic"
                                                       Opacity="0.72"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="72"/>

                                            </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">

                                                    <Button x:Name="RecentlyAddedDeleteButton"
                                                        Width="35"
                                                        Height="35"
                                                        Margin="0,0,14,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RecentlyAddedDeleteButton_Click"
                                                        ToolTip="Usuń">
                                                        <Image x:Name="RecentlyAddedDeleteIcon"
                                                           Source="/Assets/Icons/trash.png"
                                                           Width="30"
                                                           Height="30"
                                                           IsHitTestVisible="False"/>
                                                    </Button>

                                                    <Button x:Name="RecentlyAddedFavoriteButton"
                                                        Width="35"
                                                        Height="35"
                                                        Margin="0,0,14,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RecentlyAddedFavoriteButton_Click"
                                                        Tag="{Binding}">
                                                        <Image x:Name="RecentlyAddedFavoriteIcon"
                                                           Source="/Assets/Icons/favorite_empty.png"
                                                           Width="35"
                                                           Height="35"
                                                           Stretch="Uniform"
                                                                IsHitTestVisible="False"/>
                                                    </Button>

                                                    <Button x:Name="RecentlyAddedEditButton"
                                                        Width="35"
                                                        Height="35"
                                                        Margin="0,0,14,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RecentlyAddedEditButton_Click"
                                                        ToolTip="Edytuj">
                                                        <Image x:Name="RecentlyAddedEditIcon"
                                                           Source="/Assets/Icons/edit.png"
                                                           Width="30"
                                                           Height="30"
                                                           IsHitTestVisible="False"/>
                                                    </Button>

                                                    <Button x:Name="RecentlyAddedPreviewButton"
                                                        Width="35"
                                                        Height="35"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RecentlyAddedPreviewButton_Click"
                                                        Tag="{Binding}">
                                                        <Image x:Name="RecentlyAddedPreviewIcon"
                                                           Source="/Assets/Icons/view.png"
                                                           Width="30"
                                                           Height="30"
                                                           Stretch="Uniform"
                                                           IsHitTestVisible="False"/>
                                                    </Button>

                                                </StackPanel>

                                            </Grid>
                                            
                                            
                                    </Grid>
                                  </StackPanel>
                                </Border>

                                <StackPanel x:Name="CollectionTilesSectionsPanel"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="CollectionPaginationBar"
                            Grid.Row="1"
                            Margin="10,0,10,10"
                            Padding="8"
                            CornerRadius="8"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">

                            <StackPanel x:Name="CollectionPaginationPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"/>

                        </Border>

                    </Grid>

                    <Border x:Name="AddServicePanel"
                        Visibility="Collapsed"
                        Panel.ZIndex="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="24"
                        CornerRadius="12"
                        Background="{DynamicResource PreviewBoxBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock x:Name="ServiceTitle"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                            <TextBlock x:Name="ServiceDateLabel"
                                Margin="0,0,0,6"/>

                            <DatePicker x:Name="ServiceDatePicker"
                                Height="34"
                                Margin="0,0,0,12"/>             

                            <TextBlock x:Name="ServiceTypeLabel"
                                Margin="0,0,0,6"/>

                            <ComboBox x:Name="ServiceTypeCombo"
                                Height="34"
                                Margin="0,0,0,12"/>

                            <TextBlock x:Name="ServiceCostLabel"
                                Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ServiceCostTextBox"
                                  Grid.Column="0"
                                  Height="34"/>

                                <ComboBox x:Name="ServiceCostCurrencyCombo"
                                  Grid.Column="2"
                                  Height="34"/>
                            </Grid>

                            <TextBlock x:Name="ServiceNotesLabel"
                                Margin="0,0,0,6"/>

                            <TextBox x:Name="ServiceNotesTextBox"
                                 Height="100"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="8"
                                 Margin="0,0,0,16"/>            

                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                <Button x:Name="SaveServiceButton"
                                    Width="140"
                                    Height="38"
                                    Margin="0,0,10,0"
                                    Click="SaveServiceButton_Click"/>       

                                <Button x:Name="CancelServiceButton"
                                    Width="140"
                                    Height="38"
                                    Click="CancelServiceButton_Click"/>

                            </StackPanel>

                            </StackPanel>

                            <Border Grid.Column="2"
                                Padding="12"
                                CornerRadius="10"
                                Background="{DynamicResource ContentBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">

                                <StackPanel>
                                    <TextBlock x:Name="ServiceHistoryTitle"
                                       Text="Historia serwisowa"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                                    <ListBox x:Name="ServiceHistoryListBox"
                                         Height="360"
                                         SelectionChanged="ServiceHistoryListBox_SelectionChanged"
                                         Background="{DynamicResource ContentBackgroundBrush}"
                                         Foreground="{DynamicResource AppTextBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         BorderThickness="1"/>

                                    <Button x:Name="DeleteServiceEntryButton"
                                        Width="140"
                                        Height="34"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        Click="DeleteServiceEntryButton_Click"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>