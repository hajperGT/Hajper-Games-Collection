                           MouseLeftButtonDown="SearchIcon_MouseLeftButtonDown"/>

                        <TextBlock x:Name="SearchLabel"
                           Text="Szukaj"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"
