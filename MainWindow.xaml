                                        Padding="18"
                                        CornerRadius="12"
                                        Background="{DynamicResource PreviewBoxBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,14">

                                        <StackPanel>
                                            <TextBlock x:Name="HardwarePurchaseSectionTitle"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Margin="0,0,0,14"/>

