                                            <ComboBox x:Name="HardwareBoxConditionCombo"
                                              Height="34"
                                              Margin="0,0,0,12"/>

                                            <CheckBox x:Name="HardwareHasManualCheckBox"
                                                Margin="0,0,0,8"/>

                                            <CheckBox x:Name="HardwareHasInsertsCheckBox"
                                                Margin="0,0,0,8"/>

                                            <CheckBox x:Name="HardwareHasPowerSupplyCheckBox"
                                                Margin="0,0,0,8"/>

                                            <CheckBox x:Name="HardwareHasCableCheckBox"
                                                Margin="0,0,0,8"/>

                                            <StackPanel Margin="0,0,0,8">

                                                <CheckBox x:Name="HardwareHasControllerCheckBox"/>

                                                <TextBlock x:Name="HardwareControllerHintText"
