                                        Padding="18"
                                        CornerRadius="12"
                                        Background="{DynamicResource PreviewBoxBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1">

                                        <StackPanel>
                                            <TextBlock x:Name="HardwareNotesSectionTitle"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Margin="0,0,0,14"/>

                                            <TextBox x:Name="HardwareNotesTextBox"
                                                 Height="120"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

