                                              Height="34"
                                              Margin="0,0,0,12"
                                              SelectionChanged="HardwareModelCombo_SelectionChanged"/>
                                            <TextBox x:Name="HardwareModelTextBox"
                                              Height="34"
                                              Margin="0,0,0,12"
                                              Visibility="Collapsed"/>

                                            <TextBlock x:Name="HardwareRevisionLabel" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="HardwareRevisionCombo"
                                              Height="34"
                                              Margin="0,0,0,12"
