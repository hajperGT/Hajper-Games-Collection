                                    <Border x:Name="HardwareDetailsSection"
                                        Padding="18"
                                        CornerRadius="12"
                                        Background="{DynamicResource PreviewBoxBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,14">

                                        <StackPanel>
                                            <TextBlock x:Name="HardwareDetailsSectionTitle"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Margin="0,0,0,14"/>

                                            <TextBlock x:Name="HardwareModelLabel" Margin="0,0,0,6"/>
