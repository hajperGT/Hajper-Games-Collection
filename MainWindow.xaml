                        Padding="24"
                        CornerRadius="18"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">

                        <Border.Effect>
                            <DropShadowEffect
                                Color="Black"
                                BlurRadius="28"
                                ShadowDepth="8"
                                Opacity="0.55"/>
                        </Border.Effect>

                        <StackPanel>

                            <Grid Margin="0,0,0,22">

                                <TextBlock x:Name="AddChoiceTitle"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                                <Button x:Name="CloseAddChoiceButton"
                                    Content="X"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#B3261E"
                                    Foreground="White"
                                    BorderBrush="#B3261E"
                                    Click="CloseAddChoiceButton_Click"/>

                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                <Button x:Name="AddHardwareButton"
                                    Style="{StaticResource AddTileButtonStyle}"
                                    Margin="0,0,20,0"
                                    Click="AddHardwareButton_Click">
                                    <StackPanel>
                                        <Image x:Name="AddHardwareIcon"
                                           Width="128"
                                           Height="96"
                                           Stretch="Uniform"
                                           Margin="0,0,0,12"/>

                                        <TextBlock x:Name="AddHardwareText"
                                           HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="AddGameButton"
                                    Style="{StaticResource AddTileButtonStyle}"
                                    Click="AddGameButton_Click">
                                    <StackPanel>
                                        <Image x:Name="AddGameIcon"
                                           Width="128"
                                           Height="96"
                                           Stretch="Uniform"
                                           Margin="0,0,0,12"/>

                                        <TextBlock x:Name="AddGameText"
                                           HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>

                            <StackPanel x:Name="AddHardwareSubChoicePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Margin="0,22,0,0">

                                <Button x:Name="AddConsoleButton"
                                    Style="{StaticResource AddTileButtonStyle}"
                                    Width="170"
                                    Height="160"
                                    Margin="0,0,12,0"
                                    Click="AddConsoleButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="118"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Image x:Name="AddConsoleIcon"
                                           Grid.Row="0"
                                           Width="150"
                                           Height="118"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                        <TextBlock x:Name="AddConsoleText"
                                           Grid.Row="1"
                                           Text="Dodaj konsolę"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </Grid>
                                </Button>

                                <Button x:Name="AddAccessoryButton"
                                    Style="{StaticResource AddTileButtonStyle}"
                                    Width="170"
                                    Height="160"
                                    Margin="0,0,12,0"
                                    Click="AddAccessoryButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="118"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Image x:Name="AddAccessoryIcon"
                                           Grid.Row="0"
                                           Width="150"
                                           Height="118"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                        <TextBlock x:Name="AddAccessoryText"
                                           Grid.Row="1"
                                           Text="Dodaj akcesoria"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </Grid>
                                </Button>

                                <Button x:Name="AddPcButton"
                                    Style="{StaticResource AddTileButtonStyle}"
                                    Width="170"
                                    Height="160"
                                    Click="AddPcButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="118"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Image x:Name="AddPcIcon"
                                           Grid.Row="0"
                                           Width="150"
                                           Height="118"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                        <TextBlock x:Name="AddPcText"
                                           Grid.Row="1"
                                           Text="Dodaj komputer"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{DynamicResource ButtonTextBrush}"/>
                                    </Grid>
                                </Button>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <ScrollViewer x:Name="AddHardwareFormPanel"
                      Panel.ZIndex="4"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,18">

                                <TextBlock x:Name="AddHardwareFormTitle"
                                   FontSize="26"
                                    FontWeight="Bold"
                                    Opacity="0.85"   
                                    Margin="10,10,0,0"    
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   VerticalAlignment="Center"/>

                                <Button x:Name="CancelHardwareFormButton"
                                    Content="✕"
                                    Width="32"
                                    Height="32"
                                    Margin="12,16,0,0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Click="CancelHardwareFormButton_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEWA KOLUMNA -->
                                <StackPanel Grid.Column="0">

                                    <!-- PODSTAWOWE -->
                                    <Border Padding="18"
                                        CornerRadius="12"
                                        Background="{DynamicResource PreviewBoxBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,14">

                                        <StackPanel>
                                            <TextBlock x:Name="HardwareBasicSectionTitle"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Margin="0,0,0,14"/>

                                            <TextBlock x:Name="HardwareManufacturerLabel"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,6"/>

                                            <ComboBox x:Name="HardwareManufacturerCombo"
                                              Foreground="{DynamicResource AppTextBrush}"
                                              SelectionChanged="HardwareManufacturerCombo_SelectionChanged"
                                              Height="34"
                                              Margin="0,0,0,12"/>

                                            <TextBlock x:Name="HardwareTypeLabel"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,6"/>

                                            <ComboBox x:Name="HardwareTypeCombo"
                                              SelectionChanged="HardwareTypeCombo_SelectionChanged"
                                              Height="34"
                                              Margin="0,0,0,12"/>

                                            <TextBlock x:Name="HardwarePlatformLabel"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,6"/>

                                            <ComboBox x:Name="HardwarePlatformCombo"
                                              Height="34"
                                              Margin="0,0,0,16"
                                              SelectionChanged="HardwarePlatformCombo_SelectionChanged"/>

                                            <TextBox x:Name="HardwarePlatformTextBox"
                                                 Height="34"
                                                 Margin="0,0,0,16"
                                                 Visibility="Collapsed"/>

                                            <TextBlock x:Name="HardwareCustomNameLabel"
