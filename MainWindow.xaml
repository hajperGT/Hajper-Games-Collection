                                                    Width="130"
                                                    Height="38"
                                                    Margin="0,0,10,0"/>

                                                <Button x:Name="ToggleHardwareDetailsButton"
                                                    Width="165"
                                                    Height="38"
                                                    Margin="0,0,10,0"
                                                    Click="ToggleHardwareDetailsButton_Click"/>

                                                <Button x:Name="AddHardwarePhotoButton"
                                                    Width="145"
                                                    Height="38"
                                                    Click="AddHardwarePhotoButton_Click"/>

