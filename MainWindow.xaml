                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Margin="10"
                    Padding="10"
                    CornerRadius="10"
                    Background="{DynamicResource LeftPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="AddButton"
                            Grid.Row="0"
                            Height="42"
                            Background="{DynamicResource ButtonGradientBrush}"
                            Click="AddButton_Click"/>

                    <Grid Grid.Row="1"
                            Margin="0,12,0,12">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="GamesSectionPanel"
                Grid.Row="0">

                            <TextBlock x:Name="GamesTreeHeader"
                   Text="GRY"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Opacity="0.75"
                   Margin="2,0,0,5"
                   Foreground="{DynamicResource AppTextBrush}"/>

                            <TreeView x:Name="GamesTree"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <StackPanel x:Name="GamesFiltersPanel"
                    Margin="0,6,0,0"/>

                        </StackPanel>

                        <Border x:Name="GamesPlatformsSeparator"
            Grid.Row="2"
            Height="1"
            Opacity="0.25"
            Background="{DynamicResource AppBorderBrush}"/>

                        <TextBlock x:Name="PlatformsTreeHeader"
               Grid.Row="4"
               Margin="2,0,0,5"
               FontSize="11"
               FontWeight="SemiBold"
               Opacity="0.75"
               Foreground="{DynamicResource AppTextBrush}"/>

                        <TreeView x:Name="CollectionTree"
              Grid.Row="6"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectedItemChanged="CollectionTree_SelectedItemChanged"/>

                    </Grid>
                    
                    <StackPanel Grid.Row="2">

                        <Border Padding="10"
                            CornerRadius="8"
                            Background="{DynamicResource StatsBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="LeftCollectionStatsPanel_MouseLeftButtonUp">

                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                  BlurRadius="12"
                                  ShadowDepth="4"
                                  Opacity="0.45"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock x:Name="LeftStatsTitle"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                                <TextBlock x:Name="LeftPcCount"/>

                                <TextBlock x:Name="LeftConsoleCount"
                                    Margin="0,4,0,0"/>

                                <TextBlock x:Name="LeftAccessoryCount"
                                    Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="HomePageButton"
                            Height="40"
                            Margin="0,10,0,0"
                            Click="HomePageButton_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="1"
                Margin="0,10,10,10"
                Padding="0"
                CornerRadius="10"
                Background="{DynamicResource ContentBackgroundBrush}"                    
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">

                <Grid ClipToBounds="True">

                    <Image x:Name="ThemeBackground"
                       Stretch="Fill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Opacity="0.20"
                       Panel.ZIndex="0"/>

                    <Grid Panel.ZIndex="1"
                        Margin="24">

                        <TextBlock x:Name="MainTitle"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                        <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                            <Grid MinHeight="600">

                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="MainDescription"/>
                                    <TextBlock x:Name="PreviewText"/>
                                </StackPanel>

                                <Border x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="500"
                                    Padding="2"
                                    CornerRadius="10"
                                    Background="{DynamicResource PreviewBoxGradientBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">

                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="28"
                                            ShadowDepth="8"
                                            Opacity="0.55"/>
                                    </Border.Effect>

                                    <StackPanel HorizontalAlignment="Center">

                                        <Image x:Name="EmptyCollectionIcon"
                                           Width="500"
                                           Height="200"
                                           Stretch="Uniform"
                                           Opacity="0.90"
                                           Margin="0,0,0,8"/>

                                        <TextBlock x:Name="PreviewTitle"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Opacity="0.85"
                                           TextAlignment="Center"
                                           Margin="0,-30,0,0"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="PreviewSubtitle"
                                           FontSize="15"
                                           Margin="0,20,0,40"
                                           Opacity="0.75"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                    </StackPanel>

                                </Border>

                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    
                    <Border x:Name="AddChoicePanel"
                        Panel.ZIndex="5"
                        HorizontalAlignment="Center"
