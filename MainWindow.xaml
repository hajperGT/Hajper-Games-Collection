                                        BorderThickness="1"
                                        Margin="0,0,0,14">

                                        <StackPanel>
                                            <TextBlock x:Name="HardwareBoxSectionTitle"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               Margin="0,0,0,14"/>

                                            <CheckBox x:Name="HardwareHasBoxCheckBox"
