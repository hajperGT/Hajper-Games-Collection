<Window x:Class="HGC.PhotoGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Galeria zdjęć"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.Resources>
        <Style x:Key="HgcDialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                    CornerRadius="7"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}">

                            <Grid>
                                <Border CornerRadius="7"
                            Opacity="0.35">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                            <GradientStop Color="#88FFFFFF" Offset="0"/>
                                            <GradientStop Color="#22FFFFFF" Offset="0.45"/>
                                            <GradientStop Color="#33000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.86"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.70"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HgcCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#E81123"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#8B1A12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource AppAccentBrush}"
            BorderThickness="2"
            Background="{DynamicResource ContentBackgroundBrush}">


        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,14"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock x:Name="GalleryTitle"
                           Text="Galeria zdjęć"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="X"
                    Style="{StaticResource HgcCloseButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="1"
        Padding="12"
        CornerRadius="12"
        Background="{DynamicResource PreviewBoxBrush}"
        BorderBrush="{DynamicResource AppBorderBrush}"
        BorderThickness="1">

                <Grid>
                    <Image x:Name="MainPreviewImage"
               Stretch="Uniform"/>

                    <Grid x:Name="NoPhotoPanel"
              Visibility="Collapsed">

                        <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <Image Source="/Assets/Icons/nophoto.png"
                       Width="300"
                       Height="300"
                       Opacity="0.65"/>

                            <TextBlock x:Name="NoPhotoTitle"
                           Text="Brak zdjęć w galerii"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,-40,0,10"
                           Opacity="0.65"
                           HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
        Margin="0,14,0,14"
        Padding="10"
        CornerRadius="12"
        Background="{DynamicResource PreviewBoxBrush}"
        BorderBrush="{DynamicResource AppBorderBrush}"
        BorderThickness="1">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">

                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="{DynamicResource PanelBackgroundBrush}">
                                            <Track x:Name="PART_Track"
                                       Orientation="Horizontal"
                                       IsDirectionReversed="False">
                                                <Track.Thumb>
                                                    <Thumb Background="{DynamicResource AppAccentBrush}">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="5"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel x:Name="ThumbnailsPanel"
                    Orientation="Horizontal"/>

                </ScrollViewer>
            </Border>
               <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="AddPhotoButton"
                        Content="Dodaj zdjęcie"
                        Width="120"
                        Height="40"
                        Margin="0,0,6,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="AddPhotoButton_Click"/>

                <Button x:Name="DeletePhotoButton"
                        Content="Usuń zdjęcie"
                        Width="120"
                        Height="40"
                        Margin="0,0,6,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="DeletePhotoButton_Click"/>

                <Button x:Name="MovePhotoUpButton"
                        Content="Przesuń wyżej"
                        Width="120"
                        Height="40"
                        Margin="0,0,6,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="MovePhotoUpButton_Click"/>

                <Button x:Name="MovePhotoDownButton"
                        Content="Przesuń niżej"
                        Width="120"
                        Height="40"
                        Margin="0,0,6,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="MovePhotoDownButton_Click"/>

                <Button x:Name="SetMainPhotoButton"
                        Content="Ustaw jako główne"
                        Width="145"
                        Height="40"
                        Margin="0,0,16,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="SetMainPhotoButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Width="100"
                        Height="40"
                        Margin="0,0,6,0"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button x:Name="FinishButton"
                        Content="Zakończ"
                        Width="100"
                        Height="40"
                        Style="{StaticResource HgcDialogButtonStyle}"
                        Click="FinishButton_Click"/>
            </StackPanel>
        </Grid>

    </Border>
</Window>